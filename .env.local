# --- 数据库配置 (保持不变) ---
NEXT_PUBLIC_SUPABASE_URL=...
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
DATABASE_URL="postgresql://user:password@localhost:5432/scripture_db"

# --- AI 模型配置 ---
# 1. 你的首选模型提供商: openai | deepseek | ollama
AI_PROVIDER=ollama

# 2. OpenAI 配置
OPENAI_API_KEY=sk-xxxx

# 3. DeepSeek 配置 (如果使用)
DEEPSEEK_API_KEY=sk-xxxx

# 4. Ollama 本地配置 (默认端口 11434)
# Ollama 服务地址 (如果你是在 Mac 本机运行 npm run dev，用 localhost)
# 如果你是用 Docker 运行 Next.js，这里可能需要改为 http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# 指定你要用的具体模型名字 (必须是你已经用 `ollama pull` 下载好的)
# 例如: deepseek-r1, llama3, qwen2.5 等
# OLLAMA_MODEL=qwen3-vl:30b
OLLAMA_MODEL=deepseek-r1:32b

# 用于加密 Session 的密钥，必须设置！
# 你可以用 `openssl rand -base64 32` 生成一个随机字符串，或者随便写一个复杂的字符串
AUTH_SECRET="jKILSKls902932329183kkdfJJDS!2"

# NextAuth URL (在开发环境通常是这个，生产环境要改成你的域名)
NEXTAUTH_URL="http://localhost:3000"