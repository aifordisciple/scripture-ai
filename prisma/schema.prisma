// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"] // [新增 1] 开启 PostgreSQL 扩展支持
}

 datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // [新增 2] 声明使用 pgvector 扩展
}

// 定义圣经经文表

model BibleVerse {
  id        Int    @id @default(autoincrement())
  bookId    String @map("book_id")
  bookName  String @map("book_name")
  chapter   Int
  verse     Int
  content   String
  version   String @default("CUV")

  // [修改] 将 1536 改为 768，适配 bge-m3
  embedding Unsupported("vector(1024)")?

  @@unique([bookId, chapter, verse, version])
  @@map("bible_verses")
}

// ... 保持下方 User 相关模型不变 ...

// --- 新增用户系统相关模型 ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String    // 加密后的密码
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联数据
  settings      UserSetting?
  highlights    Highlight[]
  notes         Note[]
  cards         ScriptureCard[]
  chatMessages  ChatMessage[] // [新增] 关联聊天记录
  interactions  Interaction[] // [新增] 关联阅读记录
  planProgress  PlanProgress[] // [修改] 之前是 PlanProgress?，现在改为数组

  // [新增] 火苗统计与勋章系统
  streakCount   Int       @default(0)
  lastActiveDate DateTime?
  badges         Badge[]
}

model UserSetting {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 阅读器设置
  fontSize      Int     @default(20)
  lineHeight    Float   @default(1.8)
  isDarkMode    Boolean @default(false)
  showEnglish   Boolean @default(true)

  // 进度记忆
  lastBook      String?
  lastChapter   Int?

  // [新增] 保存 AI 定制的读经计划
  customPlans   String? @db.Text
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  verse     Int
  color     String   // "yellow", "green", "blue", "red"
  content   String?  // 选中的经文内容快照

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookId, chapter])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  verse     Int
  content   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookId, chapter])
}

model ScriptureCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl  String   @db.Text // 图片的 Base64 或 URL
  note      String?  // 备注

  createdAt DateTime @default(now())
}

// [新增] AI 聊天记录表
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade])
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// [新增] 阅读记录表
model Interaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  count     Int      @default(1) // 阅读次数

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, chapter])
  @@index([userId, bookId, chapter])
}

// [修改] 读经计划进度表（支持多计划、颗粒度任务）
model PlanProgress {
  id            String   @id @default(cuid())
  userId        String

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId        String
  startDate     DateTime @default(now())

  // [新增] 从 completedDays 升级为 completedTasks
  completedTasks String   @default("{}")
  // 格式如：{"1": ["devotional", "reading-0"], "2": ["reading-0"]}
  // [新增] 存储 AI 实时生成的灵修导读
  savedDevotionals String @default("{}")

  @@unique([userId, planId])
}

// [新增] 勋章表
model Badge {
  id        String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "STREAK_7", "STREAK_30", "PLAN_COMPLETE", "BIBLE_EXPLORER"
  earnedAt DateTime @default(now())

  @@unique([userId, type])
}
