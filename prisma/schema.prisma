// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"] // [新增 1] 开启 PostgreSQL 扩展支持
}

 datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // [新增 2] 声明使用 pgvector 扩展
}

// 定义圣经经文表

model BibleVerse {
  id        Int    @id @default(autoincrement())
  bookId    String @map("book_id")
  bookName  String @map("book_name")
  chapter   Int
  verse     Int
  content   String
  version   String @default("CUV")

  // [修改] 将 1536 改为 768，适配 bge-m3
  embedding Unsupported("vector(1024)")?

  @@unique([bookId, chapter, verse, version])
  @@map("bible_verses")
}

// ... 保持下方 User 相关模型不变 ...

// --- 新增用户系统相关模型 ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String    // 加密后的密码
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联数据
  settings      UserSetting?
  highlights    Highlight[]
  notes         Note[]
  cards         ScriptureCard[]
  chatMessages  ChatMessage[] // [新增] 关联聊天记录
  interactions  Interaction[] // [新增] 关联阅读记录
  planProgress  PlanProgress[] // [修改] 之前是 PlanProgress?，现在改为数组

  // [新增] 火苗统计与勋章系统
  streakCount   Int       @default(0)
  lastActiveDate DateTime?
  badges         Badge[]

  // [新增] 提醒与通知
  reminders    Reminder[]
  notificationTokens NotificationToken[]
  // [新增] 记忆卡片
  memoryCards  MemoryCard[]
  
  // [新增] API 密钥
  apiKeys     ApiKey[]
  // [新增] 每日活动流水
  activityLogs ActivityLog[]
}

model UserSetting {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 阅读器设置
  fontSize      Int     @default(20)
  lineHeight    Float   @default(1.8)
  isDarkMode    Boolean @default(false)
  showEnglish   Boolean @default(true)

  // 进度记忆
  lastBook      String?
  lastChapter   Int?

  // [新增] 保存 AI 定制的读经计划
  customPlans   String? @db.Text
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  verse     Int
  color     String   // "yellow", "green", "blue", "red"
  content   String?  // 选中的经文内容快照

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookId, chapter])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  verse     Int
  content   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookId, chapter])
}

model ScriptureCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl  String   @db.Text // 图片的 Base64 或 URL
  note      String?  // 备注

  createdAt DateTime @default(now())
}

// [新增] AI 聊天记录表
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// [新增] 阅读记录表
model Interaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  count     Int      @default(1) // 阅读次数

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, chapter])
  @@index([userId, bookId, chapter])
}

// [修改] 读经计划进度表（支持多计划、颗粒度任务）
model PlanProgress {
  id            String   @id @default(cuid())
  userId        String

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId        String
  startDate     DateTime @default(now())

  // [新增] 从 completedDays 升级为 completedTasks
  completedTasks String   @default("{}")
  // 格式如：{"1": ["devotional", "reading-0"], "2": ["reading-0"]}
  // [新增] 存储 AI 实时生成的灵修导读
  savedDevotionals String @default("{}")

  // [新增] 状态字段：'active' (进行中) 或 'completed' (已归档)
  status        String   @default("active")

  @@unique([userId, planId])
}

// [新增] 勋章表
model Badge {
  id        String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "STREAK_7", "STREAK_30", "PLAN_COMPLETE", "BIBLE_EXPLORER"
  earnedAt DateTime @default(now())
  @@unique([userId, type])
}

// [新增] 提醒模型
model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  time      String              // "08:00" format (HH:mm)
  planId    String?             // Optional: link to reading plan
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  
  @@unique([userId, time])
  @@index([userId])
}

// [新增] 设备通知令牌
model NotificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token     String   @unique    // FCM device token
  platform  String              // "android" | "ios"
  createdAt DateTime @default(now())
  @@index([userId])
}

// [新增] 艾宾浩斯记忆系统
model MemoryCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bookId     String   // 经文书卷ID
  chapter     Int      // 章节
  verse       Int?     // 节(可选)
  content     String   // 经文内容
  reference   String   // 引用 (如: 约3:16)
  
  // 艾宾浩斯曲线参数
  easeFactor  Float    @default(2.5)  // 难度因子
  interval    Int      @default(1)      // 当前间隔(天)
  repetitions Int      @default(0)      // 复习次数
  nextReview  DateTime @default(now()) // 下次复习时间
  lastReview  DateTime?                // 最后复习时间
  
  // 记忆状态
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 关系
  reviewLogs ReviewLog[]
  
  @@unique([userId, bookId, chapter, verse])
  @@index([userId, nextReview])
}

enum MemoryStatus {
  LEARNING   // 学习中
  REVIEW     // 复习中
  MASTERED   // 已掌握
  PAUSED     // 已暂停
}

// 复习记录
model ReviewLog {
  id          String   @id @default(cuid())
  cardId      String
  card        MemoryCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  quality     Int      // 回忆质量 0-5 (0=忘记, 5=完美)
  responseMs  Int?     // 响应时间(毫秒)
  reviewedAt  DateTime @default(now())
  @@index([cardId])
}

// [新增] API 密钥管理 (开放平台)
model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String   // 密钥名称
  key         String   @unique // API 密钥 (哈希存储)
  prefix      String   // 密钥前缀 (用于显示)
  
  // 权限控制
  permissions String[] // ["read:bible", "write:notes", ...]
  rateLimit   Int      @default(1000) // 每小时请求限制
  
  // 使用统计
  usedCount   Int      @default(0)
  lastUsedAt  DateTime?
  
  // 状态
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
}

// [新增] 教会/小组系统
model Church {
  id          String   @id @default(cuid())
  name        String
  description String?
  
  // 管理员
  ownerId     String
  
  // 设置
  isPublic    Boolean  @default(false) // 是否公开发现
  allowJoin   Boolean  @default(true)  // 是否允许加入
  
  // 成员
  members     ChurchMember[]
  
  // 小组读经计划
  groupPlans  GroupPlan[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChurchMember {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId    String
  
  role      MemberRole @default(MEMBER) // OWNER, ADMIN, MEMBER
  
  joinedAt  DateTime @default(now())
  
  @@unique([churchId, userId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// 小组读经计划
model GroupPlan {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  
  // 计划配置
  startDate   DateTime
  endDate     DateTime?
  dailyChapters String[] // 每日章节列表
  
  // 成员进度
  progress    GroupPlanProgress[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupPlanProgress {
  id          String   @id @default(cuid())
  planId      String
  plan        GroupPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  
  date        DateTime
  chaptersRead Int     @default(0)
  completed    Boolean @default(false)
  
  @@unique([planId, userId, date])
}

// 每日灵修活动流水表
// 用于支持仪表盘的折线图、柱状图及动态时间范围查询
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date        DateTime @default(now()) @db.Date
  actionType  String
  duration    Int      @default(0)
  metadata    String?  @db.Text

  createdAt   DateTime @default(now())

  @@index([userId, date])
}
