// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"] // [新增 1] 开启 PostgreSQL 扩展支持
}

 datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // [新增 2] 声明使用 pgvector 扩展
}

// 定义圣经经文表

model BibleVerse {
  id        Int    @id @default(autoincrement())
  bookId    String @map("book_id")
  bookName  String @map("book_name")
  chapter   Int
  verse     Int
  content   String
  version   String @default("CUV")

  // [修改] 将 1536 改为 768，适配 bge-m3
  embedding Unsupported("vector(1024)")?

  @@unique([bookId, chapter, verse, version])
  @@map("bible_verses")
}

// ... 保持下方 User 相关模型不变 ...

// --- 新增用户系统相关模型 ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String    // 加密后的密码
  image         String?
  role          String    @default("user") // user, admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // [新增] 禁言相关
  isMuted       Boolean   @default(false)  // 是否被禁言
  mutedAt       DateTime?  // 禁言时间
  mutedReason   String?    // 禁言原因
  mutedBy       String?    // 禁言操作的管理员ID

  // 关联数据
  settings      UserSetting?
  highlights    Highlight[]
  notes         Note[]
  cards         ScriptureCard[]
  chatMessages  ChatMessage[] // [新增] 关联聊天记录
  interactions  Interaction[] // [新增] 关联阅读记录
  planProgress  PlanProgress[] // [修改] 之前是 PlanProgress?，现在改为数组

  // [新增] 火苗统计与勋章系统
  streakCount   Int       @default(0)
  lastActiveDate DateTime?
  badges         Badge[]

  // [新增] 提醒与通知
  reminders    Reminder[]
  notificationTokens NotificationToken[]
  // [新增] 站内通知
  notifications Notification[]
  // [新增] 记忆卡片
  memoryCards  MemoryCard[]

  // [新增] API 密钥
  apiKeys     ApiKey[]
  // [新增] 每日活动流水
  activityLogs ActivityLog[]

  // [新增] 教会/小组关系
  ownedChurches Church[] @relation("ChurchOwner")
  churchMemberships ChurchMember[]

  // [新增] 小组计划进度
  groupPlanProgress GroupPlanProgress[]

  // [新增] 排行榜条目
  leaderboardEntries LeaderboardEntry[]

  // [新增] 点赞和评论
  likes    Like[]
  comments Comment[]

  // [新增] AI 会话
  chatSessions ChatSession[]

  // [新增] 自定义提示词
  customPrompts CustomPrompt[]

  // [新增] AI 解读收藏
  savedInsights SavedInsight[]

  // [新增] 小组打卡动态
  groupCheckInActivities GroupCheckInActivity[]

  // [新增] 小组聊天已读状态
  chatReadStatus GroupChatReadStatus[]

  // [新增] 好友关系
  friendsAsUser   Friend[] @relation("UserFriends")
  friendsAsFriend Friend[]

  // [新增] 私信
  sentMessages     DirectMessage[] @relation("MessageSender")
  receivedMessages DirectMessage[] @relation("MessageReceiver")

  // [新增] 用户反馈
  feedbacks Feedback[]

  // [新增] 隐私设置
  privacySettings PrivacySettings?

  // [新增] 管理员操作日志
  adminLogs AdminLog[]
}

model UserSetting {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 阅读器设置
  fontSize      Int     @default(20)
  lineHeight    Float   @default(1.8)
  isDarkMode    Boolean @default(false)
  showEnglish   Boolean @default(true)

  // 进度记忆
  lastBook      String?
  lastChapter   Int?

  // [新增] 保存 AI 定制的读经计划
  customPlans   String? @db.Text

  // [新增] AI API 配置
  apiProvider   String?  @default("openai")
  apiBaseUrl    String?
  apiKey        String?
  apiModel      String?

  // [新增] AI 回复风格设置
  aiDetail      String?  @default("balanced") // concise, balanced, detailed
  aiDepth       String?  @default("intermediate") // beginner, intermediate, academic
  aiTone        String?  @default("modern") // modern, traditional

  // [新增] 新手引导状态 (JSON 格式)
  // 格式: {"welcome": true, "reading": true, "ai": true, "plan": true, "group": true}
  onboardingCompleted String? @default("{}")

  // [新增] 通知偏好设置
  emailNotifyFeedback Boolean @default(true)  // 收到反馈回复时邮件通知
  emailNotifySystem   Boolean @default(true)  // 系统通知邮件
  browserNotify       Boolean @default(true)  // 浏览器推送通知
  soundNotify         Boolean @default(true)  // 声音提醒

  // [新增] 国际化语言设置
  locale String? // 'zh' | 'en', null = default Chinese
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  verse     Int
  color     String   // "yellow", "green", "blue", "red"
  content   String?  // 选中的经文内容快照

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookId, chapter])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  verse     Int
  content   String   @db.Text

  // [新增] 分享到小组
  isPublic  Boolean  @default(false) // 是否公开
  sharedTo  String?  // 分享到的小组ID (churchId)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookId, chapter])
  @@index([sharedTo, isPublic])
}

model ScriptureCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl  String   @db.Text // 图片的 Base64 或 URL
  note      String?  // 备注

  createdAt DateTime @default(now())
}

// [新增] AI 会话表
model ChatSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 关联的经文
  bookId      String?
  chapter     Int?
  startVerse  Int?
  endVerse    Int?

  // 会话元数据
  title       String?  // 自动生成: "《创世记》第1章 - 2024/03/12"
  mode        String   @default("general") // general, tutor, sermon, study-guide

  messages    ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, bookId, chapter])
  @@index([userId, createdAt])
}

// [新增] AI 聊天记录表
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 会话关联
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  role      String   // "user" | "assistant"
  content   String   @db.Text

  // [新增] 经文关联
  verseRef    String?  // "Gen 1:1-3"
  verseContent String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

// [新增] 阅读记录表
model Interaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId    String
  chapter   Int
  count     Int      @default(1) // 阅读次数

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId, chapter])
  @@index([userId, bookId, chapter])
}

// [修改] 读经计划进度表（支持多计划、颗粒度任务）
model PlanProgress {
  id            String   @id @default(cuid())
  userId        String

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId        String
  startDate     DateTime @default(now())

  // [新增] 从 completedDays 升级为 completedTasks
  completedTasks String   @default("{}")
  // 格式如：{"1": ["devotional", "reading-0"], "2": ["reading-0"]}
  // [新增] 存储 AI 实时生成的灵修导读
  savedDevotionals String @default("{}")

  // [新增] 状态字段：'active' (进行中) 或 'completed' (已归档)
  status        String   @default("active")

  @@unique([userId, planId])
}

// [新增] 勋章表
model Badge {
  id        String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "STREAK_7", "STREAK_30", "PLAN_COMPLETE", "BIBLE_EXPLORER"
  earnedAt DateTime @default(now())
  @@unique([userId, type])
}

// [新增] 提醒模型
model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  time      String              // "08:00" format (HH:mm)
  planId    String?             // Optional: link to reading plan
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  
  @@unique([userId, time])
  @@index([userId])
}

// [新增] 设备通知令牌
model NotificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token     String   @unique    // FCM device token
  platform  String              // "android" | "ios"
  createdAt DateTime @default(now())
  @@index([userId])
}

// [新增] 艾宾浩斯记忆系统
model MemoryCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bookId     String   // 经文书卷ID
  chapter     Int      // 章节
  verse       Int?     // 节(可选)
  content     String   // 经文内容
  reference   String   // 引用 (如: 约3:16)
  
  // 艾宾浩斯曲线参数
  easeFactor  Float    @default(2.5)  // 难度因子
  interval    Int      @default(1)      // 当前间隔(天)
  repetitions Int      @default(0)      // 复习次数
  nextReview  DateTime @default(now()) // 下次复习时间
  lastReview  DateTime?                // 最后复习时间
  
  // 记忆状态
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 关系
  reviewLogs ReviewLog[]
  
  @@unique([userId, bookId, chapter, verse])
  @@index([userId, nextReview])
}

enum MemoryStatus {
  LEARNING   // 学习中
  REVIEW     // 复习中
  MASTERED   // 已掌握
  PAUSED     // 已暂停
}

// 复习记录
model ReviewLog {
  id          String   @id @default(cuid())
  cardId      String
  card        MemoryCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  quality     Int      // 回忆质量 0-5 (0=忘记, 5=完美)
  responseMs  Int?     // 响应时间(毫秒)
  reviewedAt  DateTime @default(now())
  @@index([cardId])
}

// [新增] API 密钥管理 (开放平台)
model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String   // 密钥名称
  key         String   @unique // API 密钥 (哈希存储)
  prefix      String   // 密钥前缀 (用于显示)
  
  // 权限控制
  permissions String[] // ["read:bible", "write:notes", ...]
  rateLimit   Int      @default(1000) // 每小时请求限制
  
  // 使用统计
  usedCount   Int      @default(0)
  lastUsedAt  DateTime?
  
  // 状态
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
}

// [新增] 教会/小组系统
model Church {
  id          String   @id @default(cuid())
  name        String
  description String?

  // 管理员
  ownerId     String
  owner       User     @relation("ChurchOwner", fields: [ownerId], references: [id])

  // 设置
  isPublic    Boolean  @default(false) // 是否公开发现
  allowJoin   Boolean  @default(true)  // 是否允许加入

  // [新增] 个性化设置
  themeColor  String?  @default("#6366f1") // 主题色
  logoUrl     String?  // 小组Logo URL
  fontFamily  String?  @default("serif") // 字体样式

  // 成员
  members     ChurchMember[]

  // 小组读经计划
  groupPlans  GroupPlan[]

  // [新增] 邀请码
  inviteCodes InviteCode[]

  // [新增] 小组聊天
  chatMessages GroupChatMessage[]

  // [新增] 小组公告
  announcements GroupAnnouncement[]

  // [新增] 小组打卡动态
  activities   GroupCheckInActivity[]

  // [新增] 小组勋章
  groupBadges  GroupBadge[]

  // [新增] 小组聊天已读状态
  chatReadStatus GroupChatReadStatus[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChurchMember {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      MemberRole @default(MEMBER) // OWNER, ADMIN, MEMBER

  joinedAt  DateTime @default(now())

  @@unique([churchId, userId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// 小组读经计划
model GroupPlan {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // 计划配置
  startDate   DateTime
  endDate     DateTime?

  // [升级] 结构化任务（保留 dailyChapters 兼容旧数据）
  dailyChapters String[] // 每日章节列表（旧格式，保留兼容）

  // [新增] 结构化任务格式
  tasks       String?  @db.Text // JSON: [{ day, devotional?, readings: [{ book, chapter }] }]

  // [新增] 共享灵修导读
  sharedDevotionals String @default("{}") @db.Text

  // [新增] 计划来源
  source      String   @default("MANUAL") // MANUAL, AI_GENERATED, TEMPLATE

  // [新增] 挑战模式
  mode            String   @default("NORMAL") // NORMAL, CHALLENGE
  challengeConfig String?  @db.Text // JSON: { targetDays, rewardTitle, rewardBadge }

  // [新增] 计划高级设置
  status      String   @default("active") // active, paused, completed
  skipWeekends Boolean @default(false) // 跳过周末
  pausedAt    DateTime? // 暂停时间
  copiedFrom  String?   // 复制来源计划ID

  // 成员进度
  progress    GroupPlanProgress[]

  // [新增] 排行榜
  leaderboard LeaderboardEntry[]

  // [新增] 打卡动态
  activities  GroupCheckInActivity[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupPlanProgress {
  id          String   @id @default(cuid())
  planId      String
  plan        GroupPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  chaptersRead Int     @default(0)

  // [重构] 细粒度任务打卡
  completedTasks String @default("{}")  // JSON: { "1": ["devotional", "reading-0"] }

  // [新增] 状态管理
  status         String  @default("active")  // active, completed, paused
  lastActiveDate DateTime?

  // [新增] 连续天数统计
  streakDays    Int      @default(0)
  completedDays Int      @default(0)

  @@unique([planId, userId, date])
}

// 每日灵修活动流水表
// 用于支持仪表盘的折线图、柱状图及动态时间范围查询
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime @default(now()) @db.Date
  actionType  String
  duration    Int      @default(0)
  metadata    String?  @db.Text

  createdAt   DateTime @default(now())

  @@index([userId, date])
}

// 经文串珠关联类型枚举
enum ConnectionType {
  THEMATIC      // 主题相关
  QUOTATION     // 引用关系 (OT quoted in NT)
  PARALLEL      // 平行经文 (synoptic parallels)
  PROPHECY      // 预言应验
  ILLUSTRATION  // 例证关系
}

// 经文串珠关联模型
model VerseConnection {
  id            String   @id @default(cuid())

  // 源经文
  sourceBookId  String
  sourceChapter Int
  sourceVerse   Int

  // 目标经文
  targetBookId  String
  targetChapter Int
  targetVerse   Int

  // 关联元数据
  type          ConnectionType
  strength      Float    // 0.0 - 1.0
  description   String?  // 关联说明
  source        String   // "precomputed" | "vector" | "ai"

  createdAt     DateTime @default(now())

  @@unique([sourceBookId, sourceChapter, sourceVerse, targetBookId, targetChapter, targetVerse, type])
  @@index([sourceBookId, sourceChapter, sourceVerse])
  @@map("verse_connections")
}

// [新增] 邀请码模型
model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique // 6位短码
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdBy String
  maxUses   Int      @default(0) // 0=无限制
  usedCount Int      @default(0)
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([code])
}

// [新增] 排行榜条目模型
model LeaderboardEntry {
  id            String   @id @default(cuid())
  planId        String
  plan          GroupPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score         Int      @default(0)
  chaptersRead  Int      @default(0)
  streakDays    Int      @default(0)
  completedDays Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([planId, userId])
  @@index([planId, score(sort: Desc)])
}

// [新增] 小组聊天消息模型
model GroupChatMessage {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId    String
  content   String   @db.Text
  type      String   @default("TEXT") // TEXT, SHARE_VERSE, SYSTEM
  metadata  String?  @db.Text // JSON: { bookId, chapter, verse, content }
  createdAt DateTime @default(now())

  @@index([churchId, createdAt(sort: Desc)])
}

// [新增] 小组公告模型
model GroupAnnouncement {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  pinned    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, createdAt(sort: Desc)])
}

// [新增] 站内通知模型
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // NEW_MESSAGE, TASK_REMINDER, BADGE_EARNED, PLAN_UPDATE, MEMBER_JOIN, etc.
  title     String
  content   String?  @db.Text
  read      Boolean  @default(false)
  metadata  String?  @db.Text // JSON: { churchId, planId, senderId, etc. }
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}

// [新增] 点赞模型
model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // CHAT_MESSAGE, PROGRESS, NOTE, ANNOUNCEMENT
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// [新增] 评论模型
model Comment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // CHAT_MESSAGE, PROGRESS, NOTE, ANNOUNCEMENT
  targetId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([userId])
}

// [新增] 自定义提示词模型
model CustomPrompt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String   // 显示名称
  prompt    String   @db.Text
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// [新增] AI 解读收藏模型
model SavedInsight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId   String   // 关联的 ChatMessage ID
  bookId      String
  chapter     Int
  verse       Int?
  title       String?
  content     String   @default("") @db.Text  // 完整的AI解读内容
  tags        String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([userId, messageId])
  @@index([userId, bookId, chapter])
}

// [新增] 小组打卡动态模型
model GroupCheckInActivity {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  planId      String
  plan        GroupPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  day         Int
  taskType    String   // "devotional" | "reading" | "completion"
  bookId      String?
  chapter     Int?

  createdAt   DateTime @default(now())

  @@index([churchId, createdAt(sort: Desc)])
  @@index([planId, day])
}

// [新增] 小组勋章模型
model GroupBadge {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  type        String   // "ALL_COMPLETE", "STREAK_7", "ENCOURAGER"
  name        String
  description String?
  iconUrl     String?
  earnedAt    DateTime @default(now())
  userIds     String[]

  @@unique([churchId, type])
}

// [新增] 小组聊天已读状态模型
model GroupChatReadStatus {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt  DateTime @default(now())

  @@unique([churchId, userId])
  @@index([userId])
  @@map("group_chat_read_status")
}

// ==================================================
// 圣经地图与时间线功能模型
// ==================================================

// 地理位置模型
model BibleLocation {
  id            String   @id @default(cuid())
  nameZh        String   // 中文名称
  nameEn        String   // 英文名称
  nameOriginal  String?  // 原文名称
  aliases       String[] // 别名

  latitude      Float    // 纬度
  longitude     Float    // 经度
  region        String?  // 区域（加利利、犹大等）
  modernCountry String?  // 现代国家

  description   String?  @db.Text
  significance  String?  @db.Text // 圣经意义

  verseMentions BibleVerseLocation[]
  events        BibleEvent[]
  journeys      JourneyStop[]

  @@index([nameZh])
  @@map("bible_locations")
}

// 经文-地点关联
model BibleVerseLocation {
  id          String @id @default(cuid())
  locationId  String
  location    BibleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookId      String
  chapter     Int
  verse       Int
  mentionType String // MENTIONED, EVENT_OCCURRED, JOURNEY_POINT

  @@unique([locationId, bookId, chapter, verse])
  @@index([bookId, chapter])
  @@map("bible_verse_locations")
}

// 圣经事件模型
model BibleEvent {
  id          String   @id @default(cuid())
  titleZh     String
  titleEn     String?
  description String   @db.Text

  yearStart   Int?     // 开始年份（负数=BC）
  yearEnd     Int?
  yearApprox  Boolean  @default(false)
  periodLabel String?  // 时期标签

  locationId  String?
  location    BibleLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  bookId      String?
  chapterStart Int?
  chapterEnd   Int?

  category    String   // RELIGIOUS, POLITICAL, MILITARY, MIRACLE
  testament   String   // OLD, NEW, INTERTESTAMENTAL

  @@index([yearStart])
  @@map("bible_events")
}

// 旅程模型
model BibleJourney {
  id          String   @id @default(cuid())
  titleZh     String
  personId    String?
  yearStart   Int?
  yearEnd     Int?
  journeyType String   // MISSIONARY, EXODUS, MIGRATION
  stops       JourneyStop[]
  @@map("bible_journeys")
}

model JourneyStop {
  id         String @id @default(cuid())
  journeyId  String
  journey    BibleJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  locationId String
  location   BibleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order      Int
  verseRef   String?
  @@index([journeyId, order])
  @@map("journey_stops")
}

// ==================================================
// 主题网络图功能模型
// ==================================================

// 主题模型
model BibleTheme {
  id              String   @id @default(cuid())
  nameZh          String
  nameEn          String?
  aliases         String[]
  category        String   // THEOLOGICAL, ETHICAL, HISTORICAL, PROPHETIC
  summary         String?  @db.Text
  description     String?  @db.Text
  keyVerses       String[]

  verseCount      Int      @default(0)
  connectionCount Int      @default(0)

  verseLinks      ThemeVerseLink[]
  connections     ThemeConnection[] @relation("ThemeLinks")
  relatedThemes   ThemeConnection[] @relation("ThemeRelated")

  @@unique([nameZh])
  @@index([category])
  @@map("bible_themes")
}

// 主题-经文关联
model ThemeVerseLink {
  id         String   @id @default(cuid())
  themeId    String
  theme      BibleTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  bookId     String
  chapter    Int
  verseStart Int
  verseEnd   Int?
  relevance  Float    @default(1.0)
  linkType   String   // PRIMARY, SECONDARY, MENTIONED
  source     String   @default("MANUAL") // MANUAL, AI

  @@unique([themeId, bookId, chapter, verseStart])
  @@index([bookId, chapter])
  @@map("theme_verse_links")
}

// 主题间关联
model ThemeConnection {
  id              String   @id @default(cuid())
  themeId         String
  theme           BibleTheme @relation("ThemeLinks", fields: [themeId], references: [id], onDelete: Cascade)
  relatedThemeId  String
  relatedTheme    BibleTheme @relation("ThemeRelated", fields: [relatedThemeId], references: [id], onDelete: Cascade)
  connectionType  String   // PARENT, CHILD, RELATED, CONTRAST, FULFILLS
  strength        Float    @default(0.5)

  @@unique([themeId, relatedThemeId])
  @@map("theme_connections")
}

// ==================================================
// 用户交流与反馈功能模型
// ==================================================

// 好友关系
model Friend {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User         @relation("UserFriends", fields: [friendId], references: [id], onDelete: Cascade)
  status    FriendStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("friends")
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

// 用户反馈
model Feedback {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        FeedbackType
  title       String
  content     String         @db.Text
  screenshot  String?        @db.Text
  status      FeedbackStatus @default(OPEN)
  adminReply  String?        @db.Text
  userReply   String?        @db.Text  // 用户回复
  replies     String?        @db.Text  // JSON 格式的回复历史，支持多轮对话
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, createdAt])
  @@map("feedbacks")
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  QUESTION
  OTHER
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// 私信
model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  type       String   @default("TEXT") // TEXT, SHARE_VERSE, SHARE_NOTE
  metadata   String?  @db.Text // JSON: { bookId, chapter, verse, noteId }
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, read])
  @@map("direct_messages")
}

// 隐私设置
model PrivacySettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowDmFrom      String   @default("everyone")  // everyone, friends, nobody
  showOnlineStatus Boolean  @default(true)
  profileVisible   String   @default("friends")   // everyone, friends, nobody
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("privacy_settings")
}

// ==================================================
// 管理员系统模型
// ==================================================

// 操作日志
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action      String   // VIEW, UPDATE, DELETE, CREATE
  targetType  String   // USER, CHURCH, FEEDBACK, ANNOUNCEMENT, SYSTEM
  targetId    String?
  details     String?  @db.Text
  ip          String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_logs")
}

// 系统公告
model SystemAnnouncement {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  type      String    @default("INFO") // INFO, WARNING, MAINTENANCE
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("system_announcements")
}

// 页面访问统计
model PageView {
  id        String   @id @default(cuid())
  path      String   // 访问路径
  userId    String?  // 登录用户ID（可为空）
  sessionId String   // 匿名访客标识
  referrer  String?  // 来源
  userAgent String?  // 设备信息
  ip        String?  // IP地址
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
  @@map("page_views")
}
