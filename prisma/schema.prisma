// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // 关键：同时支持 Mac 本机开发 和 Linux (Docker) 部署
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 定义圣经经文表
model BibleVerse {
  id        Int    @id @default(autoincrement())
  bookId    String @map("book_id") // 书卷简称 Gen
  bookName  String @map("book_name") // 书卷全名 创世记
  chapter   Int
  verse     Int
  content   String
  version   String @default("CUV")

  // 复合唯一索引
  @@unique([bookId, chapter, verse, version])
  // 映射表名
  @@map("bible_verses")
}

// --- 新增用户系统相关模型 ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String    // 加密后的密码
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // 关联数据
  settings      UserSetting?
  highlights    Highlight[]
  notes         Note[]
  cards         ScriptureCard[]
}

model UserSetting {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 阅读器设置
  fontSize      Int     @default(20)
  lineHeight    Float   @default(1.8)
  isDarkMode    Boolean @default(false)
  showEnglish   Boolean @default(true)
  
  // 进度记忆
  lastBook      String?
  lastChapter   Int?
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bookId    String
  chapter   Int
  verse     Int
  color     String   // "yellow", "green", "blue", "red"
  content   String?  // 选中的经文内容快照
  
  createdAt DateTime @default(now())

  @@index([userId, bookId, chapter])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bookId    String
  chapter   Int
  verse     Int
  content   String   @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookId, chapter])
}

model ScriptureCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  imageUrl  String   @db.Text // 图片的 Base64 或 URL
  note      String?  // 备注
  
  createdAt DateTime @default(now())
}

