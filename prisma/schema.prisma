// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // 关键：同时支持 Mac 本机开发 和 Linux (Docker) 部署
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 定义圣经经文表
model BibleVerse {
  id        Int    @id @default(autoincrement())
  bookId    String @map("book_id") // 书卷简称 Gen
  bookName  String @map("book_name") // 书卷全名 创世记
  chapter   Int
  verse     Int
  content   String
  version   String @default("CUV")

  // 复合唯一索引
  @@unique([bookId, chapter, verse, version])
  // 映射表名
  @@map("bible_verses")
}
